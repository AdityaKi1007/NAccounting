              "mode": "raw",
              "raw": "{\n  \"reference_number\": \"TXN-88213-corrected\",\n  \"notes\": \"Corrected ref #\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/receipts/{{receipt_id}}",
