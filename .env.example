DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neoaccountingz
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# S3 storage for attachments (Sales Orders, Purchase Orders, Payments Received, Customers,
# Vendors) — see src/lib/s3.ts. Without these set, uploads fail with a clear "Attachments
# aren't configured" error rather than a confusing AWS SDK stack trace; everything else in
# the app keeps working normally.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
