DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neoaccountingz
AUTH_SECRET=replace-with-a-long-random-string
# Also used, unchanged, to derive the key that encrypts the SMTP password / S3 secret key an
# organization enters on the settings pages below (see src/lib/secrets-crypto.ts) — don't
# change this value on a machine that already has saved integration credentials, or they'll
# fail to decrypt and need to be re-entered.
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# S3 storage for attachments (Sales Orders, Purchase Orders, Payments Received, Customers,
# Vendors, and every other module that accepts an upload) — see src/lib/s3.ts. As of the
# Settings -> Integrations -> File Storage (S3) page, these env vars are only a FALLBACK: an
# organization that has entered its own bucket details there always takes priority. These
# still matter for a single-organization/self-hosted install that would rather configure via
# .env than the UI, or as the default every new organization falls back to until it sets its
# own. Without either configured, uploads fail with a clear "Attachments aren't configured"
# error rather than a confusing AWS SDK stack trace; everything else in the app keeps working
# normally.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# SMTP for the Send Email feature (Invoices, Sales Orders, Purchase Orders, Payments
# Received) — see src/lib/email.ts. Works with any SMTP provider: Gmail, Office 365, Zoho
# Mail, or your own mail server. As of the Settings -> Integrations -> Email (SMTP) page,
# these env vars are only a FALLBACK — same relationship to the settings page as the S3 vars
# above. Without either configured, sending fails with a clear "Email sending isn't
# configured" error rather than a raw socket error; everything else in the app keeps working
# normally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional — defaults to SMTP_USER if not set.
SMTP_FROM=
# Optional — set to "true" only for a provider that requires implicit TLS on a nonstandard
# port. Port 465 always uses implicit TLS automatically; every other port (587, 25) already
# negotiates STARTTLS on its own.
SMTP_SECURE=
